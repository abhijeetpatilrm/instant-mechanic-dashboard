// Instant Mechanic — Prisma Schema
// Normalized schema supporting real-time operations dashboard

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum BookingStatus {
  PENDING
  ASSIGNED
  MECHANIC_ON_THE_WAY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MechanicSpecialization {
  GENERAL
  ENGINE
  TRANSMISSION
  ELECTRICAL
  BRAKES
  TYRES
  AC_HEATING
  DIAGNOSTICS
  BODYWORK
  OIL_CHANGE
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String   @unique
  phone     String   @unique
  address   String?
  city      String?
  state     String?
  zipCode   String?  @map("zip_code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  vehicles Vehicle[]
  bookings Booking[]

  @@index([email])
  @@index([phone])
  @@index([createdAt])
  @@index([firstName, lastName])
  @@map("customers")
}

model Vehicle {
  id           String   @id @default(cuid())
  customerId   String   @map("customer_id")
  make         String
  model        String
  year         Int
  licensePlate String   @unique @map("license_plate")
  vin          String?  @unique
  color        String?
  mileage      Int?     @map("mileage_km") // in km (Indian standard)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([customerId])
  @@index([licensePlate])
  @@map("vehicles")
}

model Mechanic {
  id                String                   @id @default(cuid())
  firstName         String                   @map("first_name")
  lastName          String                   @map("last_name")
  email             String                   @unique
  phone             String                   @unique
  specializations   MechanicSpecialization[]
  isAvailable       Boolean                  @default(true) @map("is_available")
  isActive          Boolean                  @default(true) @map("is_active")
  rating            Float?                   // 0.0–5.0, updated after each booking
  totalJobs         Int                      @default(0) @map("total_jobs")
  experienceYears   Int                      @default(1) @map("experience_years")
  // Last known GPS position (Phase 3 — real-time)
  latitude          Float?
  longitude         Float?
  locationUpdatedAt DateTime?                @map("location_updated_at")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  // Relations
  bookings Booking[]

  @@index([isAvailable])
  @@index([isActive])
  @@index([rating])
  @@index([isActive, isAvailable])
  @@map("mechanics")
}

model ServiceCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  iconSlug    String?  @map("icon_slug")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  services Service[]

  @@map("service_categories")
}

model Service {
  id                String          @id @default(cuid())
  categoryId        String          @map("category_id")
  name              String
  description       String?
  basePrice         Decimal         @map("base_price") @db.Decimal(10, 2)
  estimatedDuration Int             @map("estimated_duration") // minutes
  isActive          Boolean         @default(true) @map("is_active")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  // Relations
  category ServiceCategory @relation(fields: [categoryId], references: [id])
  bookings Booking[]

  @@index([categoryId])
  @@index([isActive])
  @@map("services")
}

model Booking {
  id            String        @id @default(cuid())
  customerId    String        @map("customer_id")
  vehicleId     String        @map("vehicle_id")
  mechanicId    String?       @map("mechanic_id")
  serviceId     String        @map("service_id")
  status        BookingStatus @default(PENDING)
  scheduledAt   DateTime      @map("scheduled_at")
  startedAt     DateTime?     @map("started_at")
  completedAt   DateTime?     @map("completed_at")
  cancelledAt   DateTime?     @map("cancelled_at")
  notes         String?
  internalNotes String?       @map("internal_notes")
  totalAmount   Decimal?      @map("total_amount") @db.Decimal(10, 2)
  rating        Int?          // 1–5 customer rating

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  customer Customer  @relation(fields: [customerId], references: [id])
  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id])
  mechanic Mechanic? @relation(fields: [mechanicId], references: [id])
  service  Service   @relation(fields: [serviceId], references: [id])

  @@index([status])
  @@index([scheduledAt])
  @@index([customerId])
  @@index([mechanicId])
  @@index([status, scheduledAt])
  @@index([createdAt])
  @@index([totalAmount])
  @@index([mechanicId, status])
  @@map("bookings")
}
